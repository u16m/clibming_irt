# Kaggle API credentials
# Obtain from Kaggle -> Account -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional: custom kaggle.json directory (default: ~/.kaggle)
# KAGGLE_CONFIG_DIR=/absolute/path/to/.kaggle

# Optional training defaults for Makefile overrides
# DATA=data/ifsc_full
# OUTPUT_TRAIN=results/patternB
# OUTPUT_PREDICT=results/predict
# MISSING=nan
# ROUND=final
# EPOCHS=4000
# LR=0.03
# MIN_ATTEMPTS=5
